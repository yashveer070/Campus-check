# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ATTENDANCE_SECRET_KEY=replace-with-a-long-random-secret
SESSION_COOKIE_SECURE=true
# Number of reverse proxies that you control in front of this app. Set to 1 for a
# single managed proxy or Cloudflare Tunnel; otherwise leave it at 0.
TRUSTED_PROXY_COUNT=0
# Set this to true only for an origin that is reachable exclusively through a
# Cloudflare Tunnel. Cloudflare's CF-Connecting-IP header then identifies the visitor.
TRUST_CLOUDFLARE_CONNECTING_IP=false
# Use the public egress CIDR(s) of the college WiFi, never the local 10.x/192.168.x range.
COLLEGE_IP_RANGES=203.0.113.0/24
SUBJECTS=CS101,CS102,MA101
