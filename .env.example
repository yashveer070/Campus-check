# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ATTENDANCE_SECRET_KEY=replace-with-a-long-random-secret
SESSION_COOKIE_SECURE=true
# Number of reverse proxies that you control in front of this app. Set to 1 for a
# single managed proxy; otherwise leave it at 0.
TRUSTED_PROXY_COUNT=0
# Attendance requires GPS accuracy at or better than this value.
MAX_LOCATION_ACCURACY_METERS=50
# Students must be within this distance of the classroom location.
GEOFENCE_RADIUS_METERS=50
SUBJECTS=CS101,CS102,MA101
